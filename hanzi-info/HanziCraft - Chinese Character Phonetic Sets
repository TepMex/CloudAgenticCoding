#nav-drawer.open { left: 0px; }

#nav-drawer-close { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; font-size: 28px; cursor: pointer; color: rgb(51, 51, 51); padding: 0px 4px; margin-bottom: 16px; }

.drawer-links { display: flex; flex-direction: column; gap: 0px; }

