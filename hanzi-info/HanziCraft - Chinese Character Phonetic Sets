@charset "utf-8";

html { font-size: 100%; text-size-adjust: 100%; }

body { margin: 0px; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; line-height: 1.2; color: rgb(51, 51, 51); }

a { text-decoration: none; }

a:hover { text-decoration: underline; }

img { max-width: 100%; height: auto; vertical-align: middle; border: 0px; }

button, input, select, textarea { margin: 0px; font-family: inherit; font-size: 100%; vertical-align: middle; }

.container { max-width: 1170px; margin-left: auto; margin-right: auto; padding-left: 20px; padding-right: 20px; }

.row { display: flex; flex-wrap: wrap; }

.row::after { content: ""; display: table; clear: both; }

.span1 { flex: 0 0 8.333%; max-width: 8.333%; }

.span2 { flex: 0 0 16.667%; max-width: 16.667%; }

.span3 { flex: 0 0 25%; max-width: 25%; }

.span4 { flex: 0 0 33.333%; max-width: 33.333%; }

.span5 { flex: 0 0 41.667%; max-width: 41.667%; }

.span6 { flex: 0 0 50%; max-width: 50%; }

.span7 { flex: 0 0 58.333%; max-width: 58.333%; }

.span8 { flex: 0 0 66.667%; max-width: 66.667%; }

.span9 { flex: 0 0 75%; max-width: 75%; }

.span10 { flex: 0 0 83.333%; max-width: 83.333%; }

.span11 { flex: 0 0 91.667%; max-width: 91.667%; }

.span12 { flex: 0 0 100%; max-width: 100%; }

.offset1 { margin-left: 8.333%; }

.offset2 { margin-left: 16.667%; }

.offset3 { margin-left: 25%; }

[class*="span"] .span10 { flex: 0 0 100%; max-width: 100%; }

@media (max-width: 767px) {
  .row { flex-direction: column; }
  [class*="span"] { flex: 0 0 100%; max-width: 100%; }
  [class*="offset"] { margin-left: 0px; }
}

.btn { display: inline-block; padding: 4px 12px; margin-bottom: 0px; font-size: 14px; line-height: 20px; text-align: center; vertical-align: middle; cursor: pointer; background-color: rgb(245, 245, 245); border: 1px solid rgb(204, 204, 204); border-radius: 4px; color: rgb(51, 51, 51); text-decoration: none; }

.btn:hover { background-color: rgb(230, 230, 230); text-decoration: none; }

.alert { padding: 8px 14px; margin-bottom: 10px; background-color: rgb(252, 248, 227); border: 1px solid rgb(251, 238, 213); border-radius: 4px; color: rgb(192, 152, 83); }

.alert-error { background-color: rgb(242, 222, 222); border-color: rgb(238, 211, 215); color: rgb(185, 74, 72); }

.table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }

.table th, .table td { padding: 8px; text-align: left; border-top: 1px solid rgb(221, 221, 221); }

.table thead th { vertical-align: bottom; border-bottom: 2px solid rgb(221, 221, 221); }

.table tbody tr:hover td { background-color: rgb(245, 245, 245); }

body { background-color: rgb(254, 254, 254); font-size: 14px; }

#display { padding: 10px; border: 1px solid rgb(204, 204, 204); background-color: white; font-size: 18pt; margin-bottom: 10px; position: relative; }

.border { border-radius: 5px; box-shadow: rgb(238, 238, 238) 0.07em 0.07em 0.07em; }

.login { border: 1px solid rgb(204, 204, 204); padding: 10px; }

.removefav { height: 25px; margin-right: 5px; line-height: 15px; background-color: rgb(254, 254, 254); border-style: none; color: rgb(170, 170, 170); }

.decomp-section { display: flex; flex-direction: column; gap: 0px; border: 1px solid rgb(229, 231, 235); border-radius: 8px; overflow: hidden; clear: both; margin-top: 10px; }

.decomp-row { display: flex; align-items: center; border-bottom: 1px solid rgb(229, 231, 235); }

.decomp-row:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.decomptitle { width: 110px; min-width: 110px; padding: 10px 12px; font-size: 0.95em; font-weight: 500; color: rgb(55, 65, 81); background: rgb(249, 250, 251); display: flex; align-items: center; gap: 8px; border-right: 1px solid rgb(229, 231, 235); }

.decomp-level { color: rgb(17, 24, 39); font-size: 0.85em; font-weight: 600; flex-shrink: 0; }

.decompbox { display: flex; align-items: center; padding: 14px; flex: 1 1 0%; min-width: 0px; gap: 10px; flex-wrap: wrap; }

.decomp-source { font-size: 1.2em; font-weight: 500; color: rgb(17, 24, 39); }

.decomp-arrow { color: rgb(156, 163, 175); font-size: 1.2em; flex-shrink: 0; }

.decomp-components { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

.decomp-tile { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; background: rgb(249, 250, 251); border: 1px solid rgb(240, 240, 240); border-radius: 6px; padding: 4px 10px; min-width: 36px; min-height: 40px; text-align: center; transition: background 0.15s, border-color 0.15s; box-sizing: border-box; }

.decomp-tile:hover { background: rgb(243, 244, 246); border-color: rgb(229, 231, 235); }

.decomp-tile-link, .decomp-tile-link:hover { text-decoration: none; cursor: pointer; }

.decomp-tile-link .decomp-tile-char { color: rgb(184, 55, 70); }

.decomp-tile a { font-size: 1.1em; text-decoration: none; color: rgb(184, 55, 70); }

.decomp-tile a:hover { color: rgb(140, 42, 53); }

.decomp-tile-char { font-size: 1.1em; color: rgb(17, 24, 39); }

.decomp-tile-meaning { font-size: 0.7em; color: rgb(107, 114, 128); margin-top: 1px; text-align: center; overflow-wrap: break-word; }

.decomp-tile-missing { font-size: 0.7em; color: rgb(156, 163, 175); min-height: 40px; max-height: 40px; }

#addfav { font-size: 0.66em; }

.meaning { margin-top: 10px; font-size: 1em; }

.appearsin { margin-top: 8px; overflow-wrap: break-word; }

.appearsinbox { padding: 8px; border: 1px solid rgb(204, 204, 204); }

.newsbite { border: 1px solid rgb(224, 198, 202); font-size: 0.9em; padding: 2px 14px; background-color: rgb(253, 245, 246); border-radius: 20px; white-space: nowrap; }

.manychar { height: 100%; }

.decomp { font-size: 0.7em; width: 100%; }

