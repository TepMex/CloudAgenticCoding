.header-links { display: flex; align-items: center; gap: 8px; }

.header-links-mobile { display: none; }

#nav-hamburger { display: none; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; padding: 6px; flex-direction: column; gap: 4px; flex-shrink: 0; }

.hamburger-bar { display: block; width: 22px; height: 3px; background: rgb(51, 51, 51); border-radius: 2px; }

