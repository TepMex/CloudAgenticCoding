#header { position: sticky; top: 0px; z-index: 1000; background-color: rgb(254, 254, 254); border-bottom: 1px solid rgb(221, 221, 221); box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 4px; margin-bottom: 20px; width: 100%; }

.header-inner { display: flex; align-items: center; justify-content: space-between; padding: 8px 20px; flex-wrap: wrap; gap: 4px 0px; }

