{
  "name": "map-of-chinese",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data:build": "$npm_execpath scripts/build-data.ts",
    "data:validate": "$npm_execpath scripts/validate-data.ts",
    "dev": "$npm_execpath ./node_modules/vite/bin/vite.js",
    "build": "$npm_execpath ./node_modules/typescript/bin/tsc -b && $npm_execpath ./node_modules/vite/bin/vite.js build",
    "test": "$npm_execpath ./node_modules/vitest/vitest.mjs run",
    "test:watch": "$npm_execpath ./node_modules/vitest/vitest.mjs",
    "preview": "$npm_execpath ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
